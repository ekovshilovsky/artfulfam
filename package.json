{
  "name": "artfulfam-platform",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:storefront": "pnpm --filter @repo/storefront dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "dev:admin": "pnpm --filter @repo/contributor-admin dev",
    "build": "turbo build",
    "build:storefront": "pnpm --filter @repo/storefront build",
    "build:api": "pnpm --filter @repo/api build",
    "build:admin": "pnpm --filter @repo/contributor-admin build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "contracts:gen": "pnpm --filter @repo/contracts gen",
    "contracts:check": "pnpm --filter @repo/contracts check",
    "pod:sync:printful": "pnpm --filter @repo/scripts pod:sync:printful"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
