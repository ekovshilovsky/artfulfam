{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "gen": "pnpm gen:openapi && pnpm gen:client",
    "gen:openapi": "tsx src/generate-openapi.ts",
    "gen:client": "openapi-typescript-codegen --input ./openapi.json --output ./src/client --client fetch",
    "check": "tsx src/check-drift.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "zod": "^3.24.5"
  }
}
