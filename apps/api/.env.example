# API Server Configuration
PORT=3001
NODE_ENV=development

# CORS - comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Storefront URL for preview links
STOREFRONT_URL=http://localhost:3000

# Database (Prisma) - to be configured
# DATABASE_URL=postgresql://user:password@localhost:5432/artfulfam

# Shopify App Credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=write_products,read_orders,write_fulfillments

# Printful API
PRINTFUL_API_KEY=

# Encryption key for storing access tokens
ENCRYPTION_KEY=
